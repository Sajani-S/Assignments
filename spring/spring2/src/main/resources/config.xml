<beans xmlns="http://www.springframework.org/schema/beans"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">



    <bean id="swiggyPartner"
          class="com.example.onlinedelivery.DeliveryPartner">
        <property name="name" value="swiggy"/>

    </bean>
    <bean id="zomatopartner"
          class="com.example.onlinedelivery.DeliveryPartner">
        <property name="name" value="Zomato"/>
    </bean>


  <bean id="pro"
        class="com.example.Ecommerce.Product">
      <property name="productid" value="101"/>
      <property name="productname" value="laptop"/>
      <property name="productprice" value="55000"/>

  </bean>


    <bean id="bank"
          class="com.example.BankingSystem.Account">
         <constructor-arg value="1001"/>
        <constructor-arg value="john"/>
        <constructor-arg value="5000"/>

    </bean>


</beans>